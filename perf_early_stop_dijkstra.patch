+int dijkstraOrientedToGoal(
+    Cell start,
+    HeadingDir startDir,
+    Cell goal,
+    PlannerObstacleMode obstacleMode,
+    HeadingDir *bestGoalDir
+) {
+    if (bestGoalDir != nullptr)
+        *bestGoalDir = DIR_NORTH;
+
+    for (int r = 1; r <= rows; r++)
+    {
+        for (int c = 1; c <= cols; c++)
+        {
+            for (int dir = 0; dir < 4; dir++)
+            {
+                orientedDist[r][c][dir] = INF;
+                orientedTrace[r][c][dir] = {0, 0, -1};
+            }
+        }
+    }
+
+    if (!inBounds(start.r, start.c) ||
+        !inBounds(goal.r, goal.c) ||
+        isStaticBlocked(start.r, start.c) ||
+        isStaticBlocked(goal.r, goal.c) ||
+        !isValidDirection((int)startDir))
+    {
+        return INF;
+    }
+
+    using QueueNode = tuple<int, int, int, int>;
+    priority_queue<QueueNode, vector<QueueNode>, greater<QueueNode>> pq;
+
+    orientedDist[start.r][start.c][startDir] = 0;
+    pq.push({0, start.r, start.c, (int)startDir});
+
+    while (!pq.empty())
+    {
+        auto [du, ur, uc, currentDirValue] = pq.top();
+        pq.pop();
+
+        if (du != orientedDist[ur][uc][currentDirValue])
+            continue;
+
+        if (ur == goal.r && uc == goal.c)
+        {
+            if (bestGoalDir != nullptr)
+                *bestGoalDir = static_cast<HeadingDir>(currentDirValue);
+
+            return du;
+        }
+
+        HeadingDir currentDir = static_cast<HeadingDir>(currentDirValue);
+        int currentTerrainCost = baseTerrainCostAt(ur, uc);
+
+        if (currentTerrainCost >= INF)
+            continue;
+
+        for (int nextDirValue = 0; nextDirValue < 4; nextDirValue++)
+        {
+            int vr = ur + ORIENTED_DR[nextDirValue];
+            int vc = uc + ORIENTED_DC[nextDirValue];
+
+            int movementCost = movementTerrainCostAt(
+                vr,
+                vc,
+                obstacleMode
+            );
+
+            if (movementCost >= INF)
+                continue;
+
+            HeadingDir nextDir = static_cast<HeadingDir>(nextDirValue);
+            int turns = quarterTurnsBetween(currentDir, nextDir);
+
+            long long candidateCost =
+                (long long)du +
+                (long long)movementCost +
+                (long long)turns * currentTerrainCost;
+
+            if (candidateCost >= INF)
+                continue;
+
+            if (candidateCost >= orientedDist[vr][vc][nextDirValue])
+                continue;
+
+            orientedDist[vr][vc][nextDirValue] = (int)candidateCost;
+            orientedTrace[vr][vc][nextDirValue] = {
+                (short)ur,
+                (short)uc,
+                (signed char)currentDirValue
+            };
+
+            pq.push({
+                (int)candidateCost,
+                vr,
+                vc,
+                nextDirValue
+            });
+        }
+    }
+
+    return INF;
+}
